# Copy this file to .env and fill in only your own local credentials.
# Never commit backend/.env or paste a real key into this example file.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI configuration. Keep this disabled unless you have API credits.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI=false
