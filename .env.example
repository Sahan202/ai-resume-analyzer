# Leave blank when the frontend and API are deployed together (for example via /api rewrites).
# For a separately hosted backend, set its public HTTPS URL, without a trailing slash.
VITE_API_BASE_URL=

# Comma-separated browser origins the FastAPI backend may accept.
CORS_ORIGINS=http://localhost:5173,https://ai-resume-analyzer-eight-orcin.vercel.app
